{
  "name": "setify-cpp",
  "displayName": "Setify C++ — C++ Setup for VS Code",
  "description": "Zero-config C++ development for VS Code on Windows — automatically detects or installs MinGW-w64 and the official C/C++ extension, so VS Code's built-in Run just works.",
  "version": "1.0.9",
  "publisher": "Syntrojex",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Other"],
  "keywords": [
    "setify-cpp",
    "setify",
    "c++",
    "cpp",
    "c-plus-plus",
    "mingw",
    "mingw-w64",
    "g++",
    "gcc",
    "compiler",
    "cpp-development",
    "vscode",
    "windows",
    "setup",
    "run",
    "beginner"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "extensionDependencies": ["ms-vscode.cpptools"],
  "contributes": {
    "commands": [
      {
        "command": "setify-cpp.setup",
        "title": "Setup C++ Compiler (runs automatically on install)",
        "category": "Setify C++"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Syntrojex/set-cpp-vscode.git"
  },
  "author": {
    "name": "Muhammad Mustafa Amir",
    "url": "https://github.com/Syntrojex"
  },
  "license": "MIT"
}
